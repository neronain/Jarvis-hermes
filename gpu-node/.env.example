# Jarvis GPU node — copy to .env and edit. Never commit .env.
#
# IMPORTANT: this file is read by systemd's EnvironmentFile=, which does NOT
# support trailing comments — `VAR=value  # note` sets VAR to the whole string
# including the "#" and the note. Comments therefore live on their own lines.
# (bash `source` does strip them, which is why a trailing comment works when
# you run ./run-stt.sh by hand and then fails under systemd.)
#
# The two tokens are shared secrets: the same values must be set on the voice
# pipeline host so its requests authenticate.

# --- auth (generate with: openssl rand -hex 32) ---
JARVIS_STT_TOKEN=
JARVIS_TTS_TOKEN=

# --- speech to text ---
JARVIS_STT_MODEL=large-v3
JARVIS_STT_PORT=8768
# "th" pins Thai; "auto" for mixed Thai/English at some cost on short clips
JARVIS_STT_LANGUAGE=th
# int8_float16 roughly halves VRAM at a small accuracy cost
JARVIS_STT_COMPUTE=float16
JARVIS_STT_BEAM=5
JARVIS_STT_VAD=1

# --- thai text to speech ---
# v1 = more natural Thai, v2 = fewer misreadings (uses IPA)
JARVIS_TTS_MODEL=v2
JARVIS_TTS_PORT=8769
# lower = faster, slightly rougher
JARVIS_TTS_STEP=32
JARVIS_TTS_CFG=2.0
# must match voice.sample_rate on the host
JARVIS_TTS_PCM_RATE=16000
# keep above the sentence splitter's 220 cap
JARVIS_TTS_MAX_CHARS=250

# --- stats panel ---
JARVIS_STATS_PORT=8767

# --- bind address ---
# 0.0.0.0 exposes the sidecars on every interface. On a Tailscale-only node,
# prefer binding to the tailnet address — see docs/SECURITY.md.
JARVIS_STT_HOST=0.0.0.0
JARVIS_TTS_HOST=0.0.0.0
