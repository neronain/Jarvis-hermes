# Jarvis GPU node — copy to .env and edit. Never commit .env.
#
# The two tokens are shared secrets: the same values must be set on the voice
# pipeline host so its requests authenticate.

# --- auth (generate with: openssl rand -hex 32) ---
JARVIS_STT_TOKEN=
JARVIS_TTS_TOKEN=

# --- speech to text ---
JARVIS_STT_MODEL=large-v3
JARVIS_STT_PORT=8768
JARVIS_STT_LANGUAGE=th        # "auto" for mixed Thai/English
JARVIS_STT_COMPUTE=float16    # int8_float16 halves VRAM at a small accuracy cost
JARVIS_STT_BEAM=5
JARVIS_STT_VAD=1

# --- thai text to speech ---
JARVIS_TTS_MODEL=v2           # v1 = more natural Thai, v2 = fewer misreadings (IPA)
JARVIS_TTS_PORT=8769
JARVIS_TTS_STEP=32            # lower = faster, slightly rougher
JARVIS_TTS_CFG=2.0
JARVIS_TTS_PCM_RATE=16000     # must match the voice server's output_format

# --- stats panel ---
JARVIS_STATS_PORT=8767

# --- bind address ---
# 0.0.0.0 exposes the sidecars to every interface. On a Tailscale-only node,
# prefer binding to the tailnet address — see docs/SECURITY.md.
JARVIS_STT_HOST=0.0.0.0
JARVIS_TTS_HOST=0.0.0.0
