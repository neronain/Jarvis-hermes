# Host-side secrets for Jarvis-hermes.
#
# These belong in ~/.hermes/.env (the voice server reads Hermes' env file), not
# in a file inside this repo. Shown here only as a checklist.

# Shared with the GPU node — must match gpu-node/.env exactly.
JARVIS_STT_TOKEN=
JARVIS_TTS_TOKEN=

# HUD browser auth. Unset = auth disabled (don't do that outside localhost).
JARVIS_HUD_TOKEN=

# Hermes Agent API key — already present if `hermes serve` is configured.
API_SERVER_KEY=
